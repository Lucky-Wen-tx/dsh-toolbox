{
  "name": "dsh-toolbox",
  "version": "0.4.0",
  "description": "Session cleanup for the DeepSeek Harness Web UI: archive a session in place, then destroy it for good.",
  "type": "module",
  "main": "src/host/index.js",
  "scripts": {
    "test": "node test/smoke.mjs && node test/client.mjs"
  },
  "exports": {
    ".": "./src/host/index.js",
    "./client": "./src/client/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "session",
    "cleanup",
    "archive",
    "delete"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lucky-Wen-tx/dsh-toolbox.git"
  },
  "homepage": "https://github.com/Lucky-Wen-tx/dsh-toolbox#readme",
  "bugs": {
    "url": "https://github.com/Lucky-Wen-tx/dsh-toolbox/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT"
}
